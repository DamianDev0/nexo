{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "src/proxy.ts",
    "src/instrumentation*.ts",
    "vitest.stryker.config.mts",
    "tests/**/*.{ts,tsx}",
    "e2e/**/*.ts",
    ".storybook/**/*.{ts,tsx}",
    "src/**/*.stories.{ts,tsx}",
    "scripts/**/*.mjs"
  ],
  "project": ["src/**/*.{ts,tsx}", "tests/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["src/shared/ui/ruixen/toolbar-dock.tsx"],
  "ignoreDependencies": [
    "@repo/eslint-config",
    "@repo/typescript-config",
    "tailwindcss",
    "tw-animate-css"
  ]
}
